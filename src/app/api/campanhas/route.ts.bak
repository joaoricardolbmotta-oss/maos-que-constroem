import { NextRequest, NextResponse } from 'next/server';
import { z } from 'zod';
import { supabaseServer } from '@/lib/supabase';
import { requireAdmin } from '@/lib/auth';
import { campaignSchema } from '@/lib/validators';

/**
 * GET /api/campanhas - Lista campanhas
 * Query: ?status=draft|planned|active|finished
 */
export async function GET(_request: NextRequest) {
  try {
    const searchParams = request.nextUrl.searchParams;
    const status = searchParams.get('status');
    const page = parseInt(searchParams.get('page') || '1');
    const limit = parseInt(searchParams.get('limit') || '10');

    const supabase = supabaseServer();

    let query = supabase.from('campanhas').select('*', { count: 'exact' });

    // Filtrar por status se fornecido
    if (status) {
      query = query.eq('status', status);
    }

    // Pagination
    const from = (page - 1) * limit;
    query = query.range(from, from + limit - 1);

    // Ordenar por data descrescente
    query = query.order('action_date', { ascending: false }).order('id', { ascending: false });

    const { data, error, count } = await query;

    if (error) {
      throw error;
    }

    const totalPages = count ? Math.ceil(count / limit) : 0;

    return NextResponse.json(
      {
        campanhas: data,
        total: count || 0,
        page,
        limit,
        pages: totalPages,
      },
      { status: 200 }
    );
  } catch (error) {
    console.error('Get campanhas error:', error);
    return NextResponse.json({ error: 'Erro ao buscar campanhas' }, { status: 500 });
  }
}

/**
 * POST /api/campanhas - Criar campanha
 */
export async function POST(_request: NextRequest) {
  try {
    // Verifica autenticação de admin
    await requireAdmin();

    const body = await request.json();
    const data = campaignSchema.parse(body);

    const supabase = supabaseServer();

    // Verifica se slug já existe
    const { data: existing } = await supabase
      .from('campanhas')
      .select('id')
      .eq('public_slug', data.public_slug)
      .single();

    if (existing) {
      return NextResponse.json({ error: 'Slug já existe' }, { status: 409 });
    }

    // Cria campanha
    const { data: campanha, error } = await supabase
      .from('campanhas')
      .insert([
        {
          title: data.title,
          description: data.description || null,
          institution: data.institution,
          public_slug: data.public_slug,
          date_mode: data.date_mode,
          action_date: data.action_date || null,
          end_date: data.end_date || null,
          fundraising_goal: data.fundraising_goal || null,
          status: data.status,
          estimated_audience: data.estimated_audience || null,
        },
      ])
      .select()
      .single();

    if (error) {
      throw error;
    }

    return NextResponse.json({ campanha }, { status: 201 });
  } catch (error) {
    if (error instanceof z.ZodError) {
      return NextResponse.json(
        {
          error: 'Validação falhou',
          details: error.errors,
        },
        { status: 400 }
      );
    }

    if (error instanceof Error && error.message === 'Forbidden') {
      return NextResponse.json({ error: 'Sem permissão' }, { status: 403 });
    }

    console.error('Create campanha error:', error);
    return NextResponse.json({ error: 'Erro ao criar campanha' }, { status: 500 });
  }
}
